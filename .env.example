# Copie para .env e preencha.

# IA que escolhe início/fim e escreve título/gancho: gemini | anthropic | none
LLM_PROVIDER=none
GEMINI_API_KEY=
# Lista em ordem: se um estiver lotado/lento, tenta o próximo
GEMINI_MODEL=gemini-3.8-flash,gemini-3.1-flash-lite,gemini-3.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Whisper: auto escolhe GPU se tiver. Modelo padrão: large-v3 (GPU) / small (CPU)
WHISPER_DEVICE=auto
# WHISPER_MODEL=medium

# Escritório: seguidores e views do YouTube automáticos (chave grátis no Google Cloud,
# API "YouTube Data API v3"). O ID do canal começa com UC... (YouTube Studio → Configurações → Canal → Configurações avançadas)
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# Postagem (botão "Postar" do painel). Veja o README, seção "Postagem automática".
# YouTube: Google Cloud → APIs e serviços → Credenciais → ID do cliente OAuth (tipo "Aplicativo da Web"),
#   URI de redirecionamento: http://localhost:8080/oauth/youtube/volta
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# TikTok: developers.tiktok.com → app com "Login Kit" + "Content Posting API" (Direct Post)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# O TikTok exige redirect https. Cadastre um (ex.: a página do canal) e cole aqui; depois de autorizar,
# o painel pede para você colar o link da página que abriu. Vazio = usa http://localhost:8080/oauth/tiktok/volta
TIKTOK_REDIRECT_URI=
# Endereço do painel usado no redirect do login (mude se abrir por outro endereço)
# PAINEL_URL=http://localhost:8080

LOG_LEVEL=INFO
