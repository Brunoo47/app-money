# Copie para .env e preencha.

# IA que escolhe início/fim e escreve título/gancho: gemini | anthropic | none
LLM_PROVIDER=none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Whisper: auto escolhe GPU se tiver. Modelo padrão: large-v3 (GPU) / small (CPU)
WHISPER_DEVICE=auto
# WHISPER_MODEL=medium

LOG_LEVEL=INFO
